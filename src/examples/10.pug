doctype html
html
  head
    base(href="/")
    title Дмитрий Менделеев - IQChannels
    meta(charset="UTF-8")
    meta(name="viewport",content="width=device-width, initial-scale=1")

    style(type="text/css").
      html {
        width: 100%;
        height: 100%;
        overflow: scroll;
      }



      iframe {
        border: 0;
        width: 100%;
        height: 100%;
      }

  body
    h1
      a(href="widget/example.html", style="text-decoration: none") Чаты
      span(style="opacity: 0.5") &nbsp;/&nbsp;Дмитрий Менделеев (mobile)

    p Режим mobile

    p
      iframe(id="iqchannels-app-iframe",
        src="http://localhost:3000",
        style="height: 700px; width: 1250px")

    p
      button(type="button", onclick="widget.open();") Открыть
      span &nbsp;
      button(type="button", onclick="widget.close();") Закрыть
      span &nbsp;
      button(type="button", onclick="widget.refreshClient();") Обновить клиента
      span &nbsp;
      button(type="button", onclick="widget.logout();") Выйти
      span &nbsp;
      button(type="button", onclick="widget.destroy();") Уничтожить
      span &nbsp;
    div 
      h3 Отправка event:
      div(style="display:flex; gap: 10px; align-items: flex-end;")
        textarea#event-message(style="height: 100%;width: 600px;box-sizing: border-box;font-family: monospace;padding: 10px;", oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'")  
        button(onclick="widget.mockEvent();") Отправить
