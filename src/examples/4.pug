doctype html
html
  head
    base(href="/")
    title Альфред Хичкок - IQChannels
    meta(charset="UTF-8")
    meta(name="viewport",content="width=device-width, initial-scale=1")

    style(type="text/css").
      html {
        width: 100%;
        height: 100%;
        overflow: hidden;
      }

      body {
        padding-left: 10px;
      }

      iframe {
        border: 0;
        width: 100%;
        height: 100%;
      }
      #unread_count {
        font-size: 24pt;
        font-weight: 700;
      }

  body
    h1
      a(href="widget/example.html", style="text-decoration: none") Чаты
      span(style="opacity: 0.5") &nbsp;/&nbsp;Альфред Хичкок

    p
      button(type="button", onclick="widget.open();") Открыть
      span &nbsp;
      button(type="button", onclick="widget.close();") Закрыть
      span &nbsp;
      button(type="button", onclick="widget.logout();") Выйти
      span &nbsp;
      button(type="button", onclick="widget.destroy();") Уничтожить
      span &nbsp;
      button(type="button", onclick="togglePrefillMessageBlock();") Предзаполненные сообщения
        | &nbsp;

    br
    span Количество непрочитанных (обновляется само):
    span(id="unread_count")

    br
    br
    span(id="prefill_message_block")
      span(id="prefill_input_row")
        label(for="prefill_message") Введите текст:
        input(type="text", id="prefill_message")
      br
      br
      span(id="prefill_button_row")
        button(onclick="document.getElementById('file_input').click()") Загрузить файлы
        input(type="file" multiple="multiple" id="file_input" style="display:none;") 
        br
        span(id="file_names")
        br
        br
        button(type="button", onclick="widget.sendPrefilledMessage();") Отправить
